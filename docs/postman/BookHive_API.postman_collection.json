							}
						}
					]
				},
				{
					"name": "3.5 Delete My Pending or Rejected Review",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{access_token}}",
									"type": "string"
