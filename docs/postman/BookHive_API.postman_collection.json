									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Token returned with valid expiry\", function () {",
									"    json = pm.response.json();",
									"    pm.expect(json.success).to.eql(true);",
									"    pm.expect(json.data.token_type).to.eql(\"bearer\");",
									"    pm.expect(json.data.expires_in).to.be.a(\"number\");",
									"});",
									"if (pm.response.code === 200 && json && json.data && json.data.token) {",
									"    pm.environment.set(\"access_token\", json.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
