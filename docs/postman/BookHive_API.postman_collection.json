						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"BookHive Postman Sample {{$timestamp}}\",\n  \"author\": \"BookHive API\",\n  \"category\": \"Technology\",\n  \"description\": \"Sample book created through the BookHive Postman collection.\",\n  \"published_year\": 2026,\n  \"status\": \"published\"\n}"
