{
	"info": {
		"_postman_id": "b8a9202a-9f4a-4318-874e-6e2101e4d412",
		"name": "BookHive API",
		"description": "Postman API Collection for BookHive Dashboard (Laravel 10 JWT API).\n\nKey Information:\n- Authentication uses Tymon JWTAuth via `Authorization: Bearer <token>`.\n- Contains both Canonical RESTful endpoints and Legacy/Compatibility aliases.\n- Submitted reviews default to `pending` status and require moderation by an Admin/Reviewer in the dashboard.\n- Collection is intended strictly for local development or demo environment testing. Do not run elevated role or destructive requests against production environments.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "1.1 Register Customer Account",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Postman Customer\",\n  \"email\": \"postman.customer.{{$timestamp}}@example.com\",\n  \"role\": \"Customer\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/client/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"client",
								"register"
							]
						},
						"description": "Register a new public API account with Customer role using a timestamped unique email for repeatable execution. Generates a JWT token automatically upon registration."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"let json;",
									"pm.test(\"Status code is 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"pm.test(\"Response contains token and user payload\", function () {",
									"    json = pm.response.json();",
									"    pm.expect(json.success).to.eql(true);",
									"    pm.expect(json.data.token_type).to.eql(\"bearer\");",
									"    pm.expect(json.data).to.have.property(\"user\");",
									"});",
									"if (pm.response.code === 201 && json && json.data && json.data.token) {",
									"    pm.environment.set(\"access_token\", json.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "1.2 Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
