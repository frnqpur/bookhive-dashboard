						},
						"method": "DELETE",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/client/reviews/{{review_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"client",
								"reviews",
								"{{review_id}}"
							]
						},
						"description": "WARNING: Destructive action. Soft-deletes an unapproved review created by the authenticated user."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"let json;",
									"pm.test(\"Status code is 200 OK\", function () {",
