						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"rating\": 5,\n  \"title\": \"Excellent Book\",\n  \"body\": \"This review was submitted from the BookHive Postman collection.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/client/books/{{book_id}}/reviews",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"client",
								"books",
								"{{book_id}}",
